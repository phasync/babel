{
    "name": "phasync/babel",
    "description": "Source rewriting tool that redirects function calls and class names to alternative implementations, based on token_get_all()",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "source rewriting",
        "transpiler",
        "token_get_all",
        "phasync"
    ],
    "authors": [
        {
            "name": "Frode Børli",
            "email": "frode@ennerd.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "nikic/php-parser": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "phasync\\Babel\\": "src/"
        },
        "files": [
            "src/shims.php",
            "src/shims-strict.php"
        ]
    },
    "bin": [
        "bin/phasync-babel"
    ]
}
