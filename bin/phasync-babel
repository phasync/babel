#!/usr/bin/env php
<?php

declare(strict_types=1);

use phasync\Babel\Babel;

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $a) {
    if (is_file($a)) {
        require $a;
        break;
    }
}

$usage = <<<'TXT'
    usage: phasync-babel --map=map.php [--out=DIR] PATH...
      map.php returns ['functions' => [from => to], 'classes' => [from => to], 'constants' => [from => to]].
      A single file without --out is translated to stdout. With --out, files (.php) below each PATH are
      written translated to DIR, mirroring the tree. Translations keep the original path as their origin:
      they are meant to be run under that path (e.g. by a stream wrapper), not from DIR.

    TXT;
$opts = getopt('', ['map:', 'out:'], $rest);
$paths = array_slice($argv, $rest);
if (!isset($opts['map']) || !$paths || (!isset($opts['out']) && (count($paths) > 1 || is_dir($paths[0])))) {
    fwrite(STDERR, $usage);
    exit(2);
}
$map = require $opts['map'];
$babel = new Babel($map['functions'] ?? [], $map['classes'] ?? [], constants: $map['constants'] ?? []);
if (!isset($opts['out'])) {
    echo $babel->translate(file_get_contents($paths[0]), realpath($paths[0]));
    exit(0);
}
$files = $changed = 0;
foreach ($paths as $path) {
    $base = is_dir($path) ? realpath($path) : dirname(realpath($path));
    $it = is_dir($path)
        ? new RecursiveIteratorIterator(new RecursiveDirectoryIterator($path, FilesystemIterator::SKIP_DOTS))
        : [new SplFileInfo($path)];
    foreach ($it as $f) {
        if (!$f->isFile() || $f->getExtension() !== 'php') {
            continue;
        }
        ++$files;
        $real = $f->getRealPath();
        $src = file_get_contents($real);
        $out = $babel->translate($src, $real);
        $target = rtrim($opts['out'], '/') . substr($real, strlen($base));
        if (!is_dir(dirname($target))) {
            mkdir(dirname($target), 0777, true);
        }
        file_put_contents($target, $out);
        $changed += (int) ($out !== $src);
    }
}
fwrite(STDERR, "$files files, $changed changed\n");
